{
  "schema_version": 1,
  "version": "v6.3.3-final",
  "variant": "standard_no_samg",
  "dataset_manifest": "configs/datasets_v6_3_3.json",
  "datasets": [
    "emotions",
    "scene",
    "yeast",
    "chd49",
    "music",
    "gpositivepseaac",
    "genbase",
    "viruspseaac",
    "plantpseaac",
    "humanpseaac"
  ],
  "base_learners": [
    "logistic",
    "svm_calibrated",
    "mlp"
  ],
  "models": [
    "BR",
    "CC",
    "MLC_PA",
    "GSI_v6_2_1",
    "GSI_v6_3_2",
    "GSI_v6_3_3"
  ],
  "cv": {
    "outer_splits": 5,
    "shuffle": true,
    "random_state": 42,
    "model_seed_rule": "random_state + fold_index_zero_based",
    "inner_splits": 5,
    "splitter": "iterstrat.ml_stratifiers.MultilabelStratifiedKFold"
  },
  "preprocessing": {
    "scaler": "MaxAbsScaler",
    "fit_scope": "outer_train_only"
  },
  "base_learner_config": "configs/experiment.json",
  "marginal_estimator": "BinaryRelevanceClassifier_of_shared_binary_estimators",
  "mlc_pa": {
    "cost": 0.3,
    "penalty": "linear",
    "decision_policy": "hamming",
    "abstain_value": -1
  },
  "gsi_common": {
    "stratified_threshold": 0.75,
    "residual_corr_threshold": 0.25,
    "cv_folds": 5,
    "max_peeling_depth": 3,
    "peeling_metric": "selective_f1",
    "decaying_threshold": true,
    "threshold_decay_step": 0.05,
    "aug_normalization": "matching",
    "error_format": "residual",
    "cost": 0.3,
    "abstain_value": -1
  },
  "gsi_v6_3_2": {
    "gamma_min": 0.7,
    "use_prior_adaptive": true,
    "calibrate_tail": true,
    "calibration_method": "sqrt_platt",
    "precision_guard": true,
    "min_tau_1": 0.5,
    "mf_alpha": 0.25,
    "mf_z_max": 0.5
  },
  "gsi_v6_3_3": {
    "tau_balance": 0.85,
    "blend_kappa": 20.0,
    "tau_1_cap": 0.55,
    "tau_0_floor": 0.45,
    "separation_aware": false
  },
  "runtime": {
    "torch_threads": 1,
    "blas_threads": 1,
    "deterministic_torch": true,
    "allow_tf32": false,
    "require_cuda_for_mlp": true,
    "cublas_workspace_config": ":4096:8"
  },
  "evaluation": {
    "primary_metric": "Selective_Macro_F1",
    "zero_division": 0,
    "all_abstain_label_f1": 0,
    "std_ddof": 1,
    "threshold_selection": "outer_training_data_only",
    "aggregation": "mean_of_folds_then_equal_dataset_weight",
    "coverage_target_scope": "OOF_training_only"
  }
}
