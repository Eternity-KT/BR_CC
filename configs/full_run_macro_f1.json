{
  "schema_version": 1,
  "status": "frozen",
  "description": "Primary 10-dataset, 12-model schema-v3 benchmark with Per-Label Macro-F1 decision policy",
  "settings": {
    "datasets": [
      "emotions",
      "music",
      "scene",
      "yeast",
      "genbase",
      "medical",
      "enron",
      "cal500",
      "reuters-k500",
      "bibtex"
    ],
    "models": [
      "BR_Logistic",
      "BR_MLP",
      "CC_Logistic",
      "CC_MLP",
      "MLC_PA_Logistic",
      "MLC_PA_MLP",
      "GSI_MLC_PA_Logistic",
      "GSI_MLC_PA_MLP",
      "BR_SVM",
      "CC_SVM",
      "MLC_PA_SVM",
      "GSI_MLC_PA_SVM"
    ],
    "n_splits": 5,
